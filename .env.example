# ── Credenciais ────────────────────────────────────────────────────────────────
MONGO_URI="sua_string_de_conexao_aqui"
VOYAGE_API_KEY="sua_chave_voyage_aqui"
ANTHROPIC_API_KEY="sua_chave_anthropic_aqui"

# ── Identidade do cliente ───────────────────────────────────────────────────────
# CLIENT_ID é usado para nomear o banco de dados (rag_<CLIENT_ID>)
CLIENT_ID="meu_cliente"
CLIENT_NAME="Meu Cliente"
DOCUMENT_TITLE="Meu Documento"
DOCUMENT_DESCRIPTION="Converse com seus documentos corporativos via busca semântica no MongoDB Atlas."

# Opcional: nome explícito do banco (padrão: rag_<CLIENT_ID>)
# DB_NAME="rag_meu_cliente"

# Opcional: instrução extra para o system prompt
# SYSTEM_PROMPT_EXTRA="Sempre mencione o número da página ao citar informações."
