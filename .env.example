# Credentials
MONGO_URI="your_atlas_connection_string"
VOYAGE_API_KEY="your_voyage_key"
ANTHROPIC_API_KEY="your_anthropic_key"

# Tenant identity
# CLIENT_ID is used to name the database (rag_<CLIENT_ID>)
CLIENT_ID="my_tenant"
CLIENT_NAME="My Tenant"
DOCUMENT_TITLE="My Document"
DOCUMENT_DESCRIPTION="Query your corporate documents with semantic search on MongoDB Atlas."

# Optional: explicit database name (defaults to rag_<CLIENT_ID>)
# DB_NAME="rag_my_tenant"

# Optional: extra instruction appended to the system prompt
# SYSTEM_PROMPT_EXTRA="Always cite the page number when referencing information."

# Optional: comma-separated list of origins allowed to call the API in
# production deployments (defaults to the local Vite dev server).
# ALLOWED_ORIGINS="https://my-tenant.example.com"

# Resilience / retention
ANTHROPIC_TIMEOUT_SECONDS=45
ANTHROPIC_MAX_RETRIES=2
CONVERSATION_RETENTION_DAYS=30
RAG_MAX_CONCURRENCY=4
MAX_HISTORY_CHARS=48000
MAX_OUTLINE_CHARS=12000
ANTHROPIC_MAX_TOKENS=1500
