# Virtual environments and cache
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.DS_Store

# Environment variables — never commit
.env
.env.local
.env.bak

# Client documents and assets — sensitive data
data/*
!data/.gitkeep
assets/*
!assets/.gitkeep

# Per-client configuration (generated from the example)
client_config.json

# Editor backup files
*.save

# Local editor/IDE settings
.idea/
.vscode/

# Runtime logs from run.sh
.logs/

# graphify knowledge-graph output (local tooling artifact, not app code)
graphify-out/
CLAUDE.md 
